# WADE-OS 3000 Environment Configuration
PORT=3000
NODE_ENV=development

# Gemini API Key (Server-side only)
GEMINI_API_KEY=

# Storage Paths (Optional, default to ./data/*.json)
TASKS_FILE=./data/tasks.json
NOTES_FILE=./data/notes.json
MEMORIES_FILE=./data/memories.json

# Optional API Security Token (Leave blank in development)
API_AUTH_TOKEN=
